# Place in the content repository: .github/workflows/trigger-deploy.yml
name: Trigger Cloudflare Deploy

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Workers Builds
        env:
          DEPLOY_HOOK: ${{ secrets.CLOUDFLARE_DEPLOY_HOOK }}
        run: curl --fail-with-body --silent --show-error -X POST "$DEPLOY_HOOK"

{
  "name": "albumwall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-content.mjs",
    "dev": "next dev",
    "prebuild": "NODE_ENV=production node scripts/prepare-content.mjs",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "start": "next start",
    "lint": "eslint",
    "content:clone": "node scripts/fetch-content.mjs",
    "content:prepare": "node scripts/prepare-content.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@next/env": "^16.3.5",
    "@opennextjs/cloudflare": "^1.20.6",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
